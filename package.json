{
  "name": "hearsay-cloudflare",
  "private": true,
  "description": "Cloudflare Containers 部署入口：Worker + Durable Object 包住仓库根目录的 Dockerfile",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test:worker": "esbuild worker/voice.ts --format=esm --platform=neutral --outfile=.wrangler/voice-test/voice.mjs --log-level=warning && node worker/voice.test.mjs ./.wrangler/voice-test/voice.mjs",
    "test:voice-js": "node prototype/shared/voice.test.mjs prototype/shared/voice.js"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "wrangler": "4.153.0"
  }
}
