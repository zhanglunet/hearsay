/**
 * Hearsay → Cloudflare Containers。部署步骤见 docs/ops/cloudflare-deploy.md。
 * 需要 Workers Paid 计划；`wrangler deploy` 时本机或构建环境需要能运行 Docker。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hearsay",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // 非敏感配置。LLM 密钥用 `npx wrangler secret put HEARSAY_LLM_API_KEY` 设置，不要写在这里。
  // 每次部署都会用这里的 vars 覆盖 Dashboard 上同名的明文变量；要改请改这个文件。
  // LLM：DeepSeek 的 Anthropic 兼容端点（按量计费的开放 API，可用于自建应用）。
  //   HEARSAY_LLM_BASE_URL 是完整的 Messages 端点；鉴权走 x-api-key，与 Claude 官方 API 相同。
  //   deepseek-flash 便宜且快，适合实时对话；关闭 thinking 让回复更快。
  //   换回 Claude 官方 API：删掉 HEARSAY_LLM_BASE_URL 与 HEARSAY_LLM_THINKING，改 HEARSAY_LLM_MODEL。
  "vars": {
    "HEARSAY_LLM": "anthropic",
    "HEARSAY_LLM_MODEL": "deepseek-flash",
    "HEARSAY_LLM_BASE_URL": "https://api.deepseek.com/anthropic/v1/messages",
    "HEARSAY_LLM_THINKING": "disabled",
    "HEARSAY_R2_BUCKET": "hearsay-learner",
    "HEARSAY_R2_KEY": "learner/m3-learner.json"
  },

  // 学习者数据。容器不持有 R2 密钥：它的读写请求被 Worker 拦截，经这个绑定落到 R2
  // （见 worker/index.ts 的 outboundByHost）。bucket_name 要和上面的 HEARSAY_R2_BUCKET 一致。
  "r2_buckets": [{ "binding": "LEARNER_BUCKET", "bucket_name": "hearsay-learner" }],

  // Workers AI：/voice/tts（@cf/deepgram/aura-2-en）与 /voice/asr（@cf/openai/whisper-large-v3-turbo），
  // 见 worker/voice.ts。按用量计费：朗读 $0.03 / 千字符，识别 $0.000513 / 音频分钟。
  "ai": { "binding": "AI" },

  // workers.dev 公网地址：hearsay.zhanglu-net.workers.dev。
  // 2026-10-27 已在 Zero Trust 配好 Access 应用「hearsay 听说练习」，绑定这个 Worker 的
  // 生产和预览 URL，只放行账号所有者邮箱。删掉那个 Access 应用前，先把这里改回 false。
  "workers_dev": true,

  // 自定义域。写在配置里，避免以后从仓库部署时被当作配置之外的路由处理掉。
  // 注意：Access 的「Worker 的生产和预览 URL」目标不覆盖自定义域；这两个主机名已作为
  // 公共主机名单独加进 Access 应用「hearsay 听说练习」。以后再加域名，务必同时加进 Access。
  "routes": [
    { "pattern": "hearsay.fans", "custom_domain": true },
    { "pattern": "www.hearsay.fans", "custom_domain": true }
  ],

  "containers": [
    {
      "class_name": "HearsayContainer",
      // durable_object 策略只接受命名镜像（images），不接受 image
      "images": { "base": { "dockerfile": "./Dockerfile" } },
      // 本账号只允许 durable_object 调度策略（default 会被拒绝）。这个策略不支持
      // max_instances，也不在这里设规格：实例由 Durable Object 启动，规格默认 lite
      // （1/16 vCPU、256 MiB）。2026-10-27 按 lite 限制实测：启动 4s、内存 18.7 MiB。
      // 单实例由 worker/index.ts 里固定用同一个名字 getContainer() 保证。
      "scheduling_policy": "durable_object"
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "HearsayContainer", "name": "HEARSAY" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HearsayContainer"] }]
}
