/**
 * Hearsay → Cloudflare Containers。部署步骤见 docs/ops/cloudflare-deploy.md。
 * 需要 Workers Paid 计划；`wrangler deploy` 时本机或构建环境需要能运行 Docker。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hearsay",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // 非敏感默认值。LLM 密钥用 `npx wrangler secret put <名字>` 设置，不要写在这里：
  //   HEARSAY_LLM_API_KEY  HEARSAY_LLM_BASE_URL
  // 每次部署都会用这里的 vars 覆盖 Dashboard 上同名的明文变量；要改默认值请改这个文件。
  "vars": {
    "HEARSAY_LLM": "mock",
    "HEARSAY_LLM_MODEL": "claude-haiku-4-5-20251001",
    "HEARSAY_R2_BUCKET": "hearsay-learner",
    "HEARSAY_R2_KEY": "learner/m3-learner.json"
  },

  // 学习者数据。容器不持有 R2 密钥：它的读写请求被 Worker 拦截，经这个绑定落到 R2
  // （见 worker/index.ts 的 outboundByHost）。bucket_name 要和上面的 HEARSAY_R2_BUCKET 一致。
  "r2_buckets": [{ "binding": "LEARNER_BUCKET", "bucket_name": "hearsay-learner" }],

  // workers.dev 公网地址：hearsay.zhanglu-net.workers.dev。
  // 2026-10-27 已在 Zero Trust 配好 Access 应用「hearsay 听说练习」，绑定这个 Worker 的
  // 生产和预览 URL，只放行账号所有者邮箱。删掉那个 Access 应用前，先把这里改回 false。
  "workers_dev": true,

  "containers": [
    {
      "class_name": "HearsayContainer",
      // durable_object 策略只接受命名镜像（images），不接受 image
      "images": { "base": { "dockerfile": "./Dockerfile" } },
      // 本账号只允许 durable_object 调度策略（default 会被拒绝）。这个策略不支持
      // max_instances，也不在这里设规格：实例由 Durable Object 启动，规格默认 lite
      // （1/16 vCPU、256 MiB）。2026-10-27 按 lite 限制实测：启动 4s、内存 18.7 MiB。
      // 单实例由 worker/index.ts 里固定用同一个名字 getContainer() 保证。
      "scheduling_policy": "durable_object"
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "HearsayContainer", "name": "HEARSAY" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HearsayContainer"] }]
}
